{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytoken.routin.ai/schema/transfer/v1",
  "title": "MyToken Transfer Package v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "credentials", "preferences", "secretEnvelope", "exportedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "credentials": { "type": "array", "items": { "$ref": "#/$defs/credential" } },
    "preferences": { "$ref": "#/$defs/preferences" },
    "secretEnvelope": { "$ref": "#/$defs/secretEnvelope" },
    "exportedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "credentialId", "providerId", "credentialKind", "name", "isEnabled", "sortOrder", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "credentialId": { "type": "string", "format": "uuid" },
        "providerId": { "enum": ["routin", "deepseek", "glm", "volcengine", "newAPI"] },
        "credentialKind": { "enum": ["bearerAPIKey", "apiKey", "accessKeyPair"] },
        "name": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": { "type": "string", "format": "uri" },
            "userID": { "type": "string" },
            "region": { "type": "string" },
            "planType": { "enum": ["personal", "coding"] },
            "usageKind": { "enum": ["periodic", "tokenPack"] },
            "websiteURL": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": true,
      "required": ["refreshIntervalMinutes", "wifiOnly", "openAppRefresh", "notificationsEnabled", "alertThresholds", "pinnedCredentialIds"],
      "properties": {
        "refreshIntervalMinutes": { "type": "integer", "enum": [1, 5, 15, 30] },
        "wifiOnly": { "type": "boolean" },
        "openAppRefresh": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "alertThresholds": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 100 } },
        "pinnedCredentialIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    "base64url": {
      "type": "string",
      "description": "Non-empty, unpadded URL-safe Base64 lexical value; lengths 4n, 4n+2, or 4n+3 are accepted.",
      "anyOf": [
        { "pattern": "^[A-Za-z0-9_-]{4}([A-Za-z0-9_-]{4})*$" },
        { "pattern": "^[A-Za-z0-9_-]{2}([A-Za-z0-9_-]{4})*$" },
        { "pattern": "^[A-Za-z0-9_-]{3}([A-Za-z0-9_-]{4})*$" }
      ]
    },
    "secretEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "keyAgreement", "nonce", "ciphertext", "tag", "ephemeralPublicKey", "entries"],
      "properties": {
        "algorithm": { "enum": ["AES-256-GCM", "ChaCha20-Poly1305"] },
        "keyAgreement": { "const": "X25519-HKDF-SHA256" },
        "nonce": { "$ref": "#/$defs/base64url" },
        "ciphertext": { "$ref": "#/$defs/base64url" },
        "tag": { "$ref": "#/$defs/base64url" },
        "ephemeralPublicKey": { "$ref": "#/$defs/base64url" },
        "associatedData": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/secretEntry" } }
      }
    },
    "secretEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["credentialId"],
      "properties": {
        "credentialId": { "type": "string", "format": "uuid" },
        "bearerToken": { "$ref": "#/$defs/base64url" },
        "apiKey": { "$ref": "#/$defs/base64url" },
        "accessKeyID": { "$ref": "#/$defs/base64url" },
        "secretAccessKey": { "$ref": "#/$defs/base64url" }
      },
      "anyOf": [
        { "required": ["bearerToken"] }, { "required": ["apiKey"] },
        { "required": ["accessKeyID", "secretAccessKey"] }
      ],
      "allOf": [
        { "if": { "required": ["accessKeyID"] }, "then": { "required": ["secretAccessKey"] } },
        { "if": { "required": ["secretAccessKey"] }, "then": { "required": ["accessKeyID"] } }
      ]
    }
  }
}
